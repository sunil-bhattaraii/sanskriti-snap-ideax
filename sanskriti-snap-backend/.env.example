# Server-only. Never prefix any of these with NEXT_PUBLIC_.
# docs/Backend TDS.md 99.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
# Transactions require a replica set. Atlas SRV clusters qualify; a standalone
# local mongod does not and will fail on the first write in withTransaction().

CLERK_SECRET_KEY=pk_test_...

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. The CV service is not reachable yet this sprint; until both are
# set, CV-enabled artifacts are refused rather than silently auto-passing.
CV_SERVICE_URL=http://127.0.0.1:8000
CV_SERVICE_SECRET=

# Not a secret, but the mobile app needs it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
