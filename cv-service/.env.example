# Set to test only for local test runs; test mode disables CV service auth.
ENVIRONMENT=production

# --- required ---
CV_SERVICE_SECRET=change-me-same-value-as-the-nextjs-backend

# --- model ---
CV_SERVICE_MODEL=openai/clip-vit-base-patch32
CV_MODEL_VERSION=1
# extra models the service will accept as a /embed or /compare override (comma separated)
CV_EXTRA_MODELS=
CV_MAX_CONCURRENT_INFERENCES=2

# --- reference store (read-only access is enough) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sanskriti-snap
MONGODB_REFERENCES_COLLECTION=artifactReferences

# --- image fetching ---
CLOUDINARY_CLOUD_NAME=
# comma separated hostnames, or * to allow any (dev only)
CV_ALLOWED_IMAGE_HOSTS=res.cloudinary.com
CV_ALLOW_HTTP_IMAGES=false
CV_IMAGE_MAX_BYTES=10485760
CV_IMAGE_FETCH_TIMEOUT_S=4

CV_DEFAULT_TOP_K=3
CV_ENABLE_DOCS=false
